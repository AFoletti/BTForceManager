# Copy this file to .env at the repo root before running `docker compose up`.
# These variables are consumed directly by docker-compose.yml.

# Host folder bind-mounted into the backend container at /data - this is
# where the SQLite database file (btforcemanager.db) will live on disk.
DB_DATA_PATH=./docker-data/db

# Host folder bind-mounted into the backend container at /watch - drop a
# mech catalog CSV here and it gets auto-imported within a few seconds.
MECH_CATALOG_WATCH_HOST_DIR=./docker-data/mech-catalog-drop

# Host port that maps to the backend container's port 8000.
BACKEND_PORT=8000

# Host port that maps to the frontend container's nginx port 80.
FRONTEND_PORT=3000

# UID/GID the backend process runs as (non-root) - should match the host
# user who owns the bind-mounted DB_DATA_PATH/MECH_CATALOG_WATCH_HOST_DIR
# folders, so the container can write to them without permission errors.
# On Synology DSM, find your user's values by SSH-ing in and running:
#   id <username>
PUID=1000
PGID=1000

# URL the frontend (baked in at build time) uses to reach the backend API.
# Point this at wherever the backend is actually reachable from the browser,
# e.g. http://<your-nas-ip>:8000
REACT_APP_BACKEND_URL=http://localhost:3000/api
