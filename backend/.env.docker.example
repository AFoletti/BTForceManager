# Copy this file to backend/.env.docker before running `docker compose up`.
# Loaded into the backend container via docker-compose.yml's env_file.
# Paths below are container-internal (see the /data and /watch volume
# mounts in docker-compose.yml) - do not point these at host paths.

# SQLAlchemy async connection string for the SQLite database file.
DATABASE_URL=sqlite+aiosqlite:////data/btforce.db

# Folder watched for auto-import of dropped mech catalog CSV files.
# Leave unset/empty to disable the watcher entirely.
MEK_CATALOG_WATCH_DIR=/watch

# Seconds to wait after a CSV file stops changing before importing it.
MEK_CATALOG_WATCH_DEBOUNCE_SECONDS=2

# Comma-separated list of allowed CORS origins, e.g.
# https://your-frontend-host:3000,https://another-host
# Only needed if the frontend is deployed on a different origin than the
# backend (see frontend/Dockerfile's REACT_APP_BACKEND_URL comment). Leave
# unset/empty for the default same-origin deployment via nginx's /api/ proxy.
CORS_ALLOWED_ORIGINS=
